FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
FEISHU_ENCRYPT_KEY=

# Optional comma-separated allowlists. Leave empty to accept all chats/users the bot can receive.
FEISHU_ALLOWED_CHATS=
FEISHU_ALLOWED_USERS=

CODEXBRIDGE_DEFAULT_CWD=/path/to/your/workspace
CODEX_NATIVE_API_ENABLE=1
